{
  "name": "@encois/persistence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "biome:check": "biome check ./src ./scripts ./drizzle.config.ts",
    "biome:format": "biome format --write ./src ./scripts ./drizzle.config.ts",
    "biome:write": "biome check --write ./src ./scripts ./drizzle.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/database.integration.test.ts",
    "db:generate": "node scripts/generate-migration.mjs",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:verify": "node scripts/verify-schema.mjs",
    "retention:cleanup": "node scripts/retention-cleanup.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
