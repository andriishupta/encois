{
  "name": "@encois/contracts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "files": ["dist", "schemas", "openapi.yaml", "permissions.json"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-permissions.mjs && tsc -p tsconfig.json",
    "generate:permissions": "node scripts/generate-permissions.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node test-contracts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "biome:check": "biome check ./src",
    "biome:write": "biome check --write ./src",
    "biome:format": "biome format --write ./src"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
