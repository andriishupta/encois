{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.com/schemas/workflow-blueprint-lifecycle.v1.json",
  "title": "Workflow Blueprint lifecycle request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "action", "reason"],
  "properties": {
    "contractVersion": { "const": "workflow-blueprint-lifecycle.v1" },
    "action": { "enum": ["create_revision", "duplicate", "deprecate", "restore", "mark_current"] },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "name": { "type": "string", "minLength": 2, "maxLength": 160 },
    "reason": { "type": "string", "minLength": 3, "maxLength": 2000 }
  }
}
