{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/release-investigation.v1.json",
  "type": "object",
  "required": ["contractVersion", "projectKey", "releaseKey"],
  "$defs": {
    "publicScope": {
      "type": "object",
      "properties": {
        "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "teamIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "contractVersion": { "const": "release-investigation.v1" },
    "projectKey": { "type": "string", "minLength": 1 },
    "releaseKey": { "type": "string", "minLength": 1 },
    "targetDate": { "type": "string" },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/publicScope" }
  },
  "additionalProperties": false
}
