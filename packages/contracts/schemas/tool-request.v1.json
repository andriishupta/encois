{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/tool-request.v1.json",
  "type": "object",
  "required": ["contractVersion", "requestId", "workflowId", "organizationId", "actorId", "scope", "policyVersion", "capability", "tool", "arguments"],
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["ids"],
      "properties": {
        "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "contractVersion": { "const": "tool-request.v1" },
    "requestId": { "type": "string" },
    "traceId": { "type": "string" },
    "workflowId": { "type": "string" },
    "runId": { "type": "string" },
    "organizationId": { "type": "string" },
    "actorId": { "type": "string" },
    "scope": { "$ref": "#/$defs/scope" },
    "policyVersion": { "type": "string" },
    "capability": { "type": "string", "minLength": 1 },
    "agentDefinition": { "type": "string" },
    "tool": { "type": "string" },
    "arguments": { "type": "object" }
  },
  "additionalProperties": false
}
