{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/workflow-change-plan.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "planId", "coordinatorId", "organizationId", "observedAt", "changes"],
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["tool", "agent", "transform", "condition", "wait", "approval"] },
        "tool": { "type": "string", "minLength": 1 },
        "agentDefinition": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "input": { "type": "object" },
        "requiresApproval": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "tool" } } }, "then": { "required": ["tool"], "properties": { "tool": { "type": "string" } } } },
        { "if": { "properties": { "kind": { "const": "agent" } } }, "then": { "required": ["agentDefinition"], "properties": { "agentDefinition": { "type": "string" } } } }
      ],
      "additionalProperties": false
    },
    "blueprint": {
      "type": "object",
      "required": ["contractVersion", "blueprintId", "version", "name", "workflowType", "purpose", "enabled", "steps"],
      "properties": {
        "contractVersion": { "const": "workflow-blueprint.v1" },
        "blueprintId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "workflowType": { "const": "encois.user-blueprint.v1" },
        "purpose": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "allowedTools": { "type": "array", "items": { "type": "string" } },
        "requiredScopes": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "object", "additionalProperties": { "type": "string" } },
        "inputSchemaRef": { "type": "string", "minLength": 1 },
        "outputSchemaRef": { "type": "string", "minLength": 1 },
        "requiresApproval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "requiresApproval"],
      "properties": {
        "kind": { "enum": ["create", "update", "deprecate", "cancel"] },
        "targetBlueprintId": { "type": "string", "minLength": 1 },
        "targetBlueprintVersion": { "type": "string", "minLength": 1 },
        "targetWorkflowId": { "type": "string", "minLength": 1 },
        "blueprint": { "$ref": "#/$defs/blueprint" },
        "start": { "$ref": "#/$defs/start" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiresApproval": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "create" } } }, "then": { "required": ["blueprint"], "properties": { "blueprint": { "type": "object" } }, "not": { "anyOf": [{ "required": ["targetBlueprintId"], "properties": { "targetBlueprintId": {} } }, { "required": ["targetBlueprintVersion"], "properties": { "targetBlueprintVersion": {} } }, { "required": ["targetWorkflowId"], "properties": { "targetWorkflowId": {} } }] } } },
        { "if": { "properties": { "kind": { "const": "update" } } }, "then": { "required": ["targetBlueprintId", "targetBlueprintVersion", "blueprint"], "properties": { "targetBlueprintId": { "type": "string" }, "targetBlueprintVersion": { "type": "string" }, "blueprint": { "type": "object" } }, "not": { "required": ["targetWorkflowId"], "properties": { "targetWorkflowId": {} } } } },
        { "if": { "properties": { "kind": { "const": "deprecate" } } }, "then": { "required": ["targetBlueprintId", "targetBlueprintVersion"], "properties": { "targetBlueprintId": { "type": "string" }, "targetBlueprintVersion": { "type": "string" } }, "not": { "required": ["targetWorkflowId"], "properties": { "targetWorkflowId": {} } } } },
        { "if": { "properties": { "kind": { "const": "cancel" } } }, "then": { "required": ["targetWorkflowId"], "properties": { "targetWorkflowId": { "type": "string" } }, "not": { "anyOf": [{ "required": ["targetBlueprintId"], "properties": { "targetBlueprintId": {} } }, { "required": ["targetBlueprintVersion"], "properties": { "targetBlueprintVersion": {} } }, { "required": ["blueprint"], "properties": { "blueprint": {} } }] } } }
      ]
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessInput": { "type": "object" }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "workflow-change-plan.v1" },
    "planId": { "type": "string", "minLength": 1 },
    "coordinatorId": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "minLength": 1 },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } }
  }
}
