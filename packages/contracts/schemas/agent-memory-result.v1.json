{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/agent-memory-result.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "status", "memories"],
  "$defs": {
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agentDefinition", "summary", "evidenceRefs", "observedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "agentDefinition": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "observedAt": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "agent-memory-result.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "deferred", "failed"] },
    "memories": { "type": "array", "items": { "$ref": "#/$defs/memory" } }
  }
}
