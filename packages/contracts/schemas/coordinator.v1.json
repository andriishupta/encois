{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.com/schemas/coordinator.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "coordinatorId",
    "organizationId",
    "scopeType",
    "scope",
    "policyVersion",
    "state"
  ],
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "onboardingComplete",
        "reconciliationCount"
      ],
      "properties": {
        "status": {
          "enum": [
            "CREATED",
            "ONBOARDING",
            "BOOTSTRAPPING",
            "READY",
            "RECONCILING",
            "WAITING",
            "SUSPENDED"
          ]
        },
        "version": { "type": "integer", "minimum": 0 },
        "onboardingComplete": { "type": "boolean" },
        "connectedIntegrationIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "activeWorkflowIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "processedEventIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "processedSignalIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "memoryVersion": { "type": "string", "minLength": 1 },
        "lastEvent": { "type": "string", "minLength": 1 },
        "lastError": { "type": "string", "minLength": 1 },
        "reconciliationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "coordinator.v1" },
    "coordinatorId": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "scopeType": { "enum": ["organization", "project"] },
    "scope": { "$ref": "#/$defs/scope" },
    "actorId": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "coordinationMode": { "type": "string", "minLength": 1 },
    "selectedWorkflowRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "state": { "$ref": "#/$defs/state" }
  }
}
