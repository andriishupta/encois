{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/blueprint-workflow-result.v1.json",
  "type": "object",
  "required": ["contractVersion", "status", "steps"],
  "$defs": {
    "stepResult": {
      "type": "object",
      "required": ["stepId", "status"],
      "properties": {
        "stepId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "statusReason": { "enum": ["temporary_error", "missing_credentials", "human_approval", "capability_unavailable", "provider_unavailable", "invalid_input", "degraded_evidence"] },
        "data": { "type": "object" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "trace": { "$ref": "#/$defs/trace" },
        "freshness": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "observedAt", "status"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "minLength": 1 },
              "ingestedAt": { "type": "string", "minLength": 1 },
              "expiresAt": { "type": "string", "minLength": 1 },
              "status": { "enum": ["fresh", "stale", "unknown"] }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceRevisionId": { "type": "string", "minLength": 1 },
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "artifactRef": { "type": "string", "minLength": 1 },
        "locator": { "type": "object" },
        "observedAt": { "type": "string", "minLength": 1 },
        "ingestedAt": { "type": "string", "minLength": 1 },
        "transformationVersion": { "type": "string", "minLength": 1 },
        "visibilityScope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1 },
        "budget": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "redacted": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "blueprint-workflow-result.v1" },
    "status": { "enum": ["completed", "waiting", "failed"] },
    "statusReason": { "enum": ["temporary_error", "missing_credentials", "human_approval", "capability_unavailable", "provider_unavailable", "invalid_input", "degraded_evidence"] },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/stepResult" } }
  },
  "additionalProperties": false
}
