{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/workflow-blueprint.v1.json",
  "type": "object",
  "required": ["contractVersion", "blueprintId", "version", "name", "workflowType", "purpose", "enabled", "steps"],
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["tool", "agent", "transform", "condition", "wait", "approval"] },
        "tool": { "type": "string", "minLength": 1 },
        "agentDefinition": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "input": { "type": "object" },
        "requiresApproval": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "tool" } } }, "then": { "required": ["tool"], "properties": { "tool": { "type": "string" } } } },
        { "if": { "properties": { "kind": { "const": "agent" } } }, "then": { "required": ["agentDefinition"], "properties": { "agentDefinition": { "type": "string" } } } }
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "contractVersion": { "const": "workflow-blueprint.v1" },
    "blueprintId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "workflowType": { "const": "encois.dynamic.v1" },
    "purpose": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "allowedTools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requiredScopes": { "type": "array", "items": { "type": "string" } },
    "parameters": { "type": "object", "additionalProperties": { "type": "string" } },
    "inputSchemaRef": { "type": "string", "minLength": 1 },
    "outputSchemaRef": { "type": "string", "minLength": 1 },
    "requiresApproval": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "steps": {
            "type": "array",
            "contains": { "type": "object", "properties": { "kind": { "const": "tool" } } }
          }
        }
      },
      "then": { "required": ["allowedTools"], "properties": { "allowedTools": { "type": "array" } } }
    }
  ],
  "additionalProperties": false
}
