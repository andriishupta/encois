{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/graph-upsert.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "workflowId", "organizationId", "actorId", "scope", "policyVersion", "capability", "nodes", "edges"],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceRevisionId": { "type": "string", "minLength": 1 },
        "artifactRef": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "minLength": 1 },
        "ingestedAt": { "type": "string", "minLength": 1 },
        "transformationVersion": { "type": "string", "minLength": 1 },
        "visibilityScope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "properties"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "properties": { "type": "object" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "targetId", "relationship", "properties"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "relationship": { "type": "string", "minLength": 1 }, "properties": { "type": "object" }, "provenance": { "$ref": "#/$defs/provenance" } }
    }
  },
  "properties": {
    "contractVersion": { "const": "graph-upsert.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  }
}
