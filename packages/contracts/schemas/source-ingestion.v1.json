{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.com/schemas/source-ingestion.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "workflowId",
    "organizationId",
    "actorId",
    "scope",
    "policyVersion",
    "capability",
    "sourceId",
    "sourceRevisionId",
    "sourceKind",
    "observedAt",
    "trigger",
    "readScope",
    "visibilityScope"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "source-ingestion.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceRevisionId": { "type": "string", "minLength": 1 },
    "sourceKind": {
      "enum": ["integration", "uploaded_document", "manual", "media"]
    },
    "provider": { "type": "string", "minLength": 1 },
    "artifactRef": { "type": "string", "minLength": 1 },
    "sourceObjectId": { "type": "string", "minLength": 1 },
    "contentType": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "trigger": {
      "enum": ["bootstrap", "manual", "webhook", "schedule", "reconcile"]
    },
    "readScope": { "$ref": "#/$defs/scope" },
    "visibilityScope": { "$ref": "#/$defs/scope" }
  }
}
