{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/tool-result.v1.json",
  "type": "object",
  "required": ["contractVersion", "requestId", "tool", "status"],
  "properties": {
    "contractVersion": { "const": "tool-result.v1" },
    "requestId": { "type": "string" },
    "tool": { "type": "string" },
    "status": { "enum": ["mocked", "completed", "waiting", "failed"] },
    "data": { "type": "object" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
