{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/artifact-read.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "workflowId", "organizationId", "actorId", "scope", "policyVersion", "capability", "artifactRef"],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "artifact-read.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "artifactRef": { "type": "string", "minLength": 1, "maxLength": 2048 }
  }
}
