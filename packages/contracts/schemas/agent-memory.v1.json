{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encois.dev/schemas/agent-memory.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "workflowId",
    "organizationId",
    "actorId",
    "scope",
    "policyVersion",
    "agentDefinition",
    "operation",
    "memoryScope"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "teamIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "memoryScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentDefinition"],
      "properties": {
        "agentDefinition": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 }
      }
    },
    "distillation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidenceRefs", "observedAt"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "observedAt": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "contractVersion": { "const": "agent-memory.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "agentDefinition": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["retrieve", "distill"] },
    "memoryScope": { "$ref": "#/$defs/memoryScope" },
    "query": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "maxResults": { "type": "integer", "minimum": 1, "maximum": 20 },
    "distillation": { "$ref": "#/$defs/distillation" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "retrieve" } } },
      "then": {
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "distill" } } },
      "then": {
        "required": ["distillation"],
        "properties": {
          "distillation": { "$ref": "#/$defs/distillation" }
        }
      }
    }
  ]
}
