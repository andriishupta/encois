{
  "name": "@encois/e2e",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck",
    "biome:check": "biome check cypress cypress.config.ts",
    "biome:format": "biome format --write cypress cypress.config.ts",
    "biome:write": "biome check --write cypress cypress.config.ts",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "format": "pnpm run biome:format",
    "format:check": "biome format cypress cypress.config.ts",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "cypress": "^14.5.4",
    "typescript": "~5.9.2"
  }
}
