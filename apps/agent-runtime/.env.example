# Keep the local worker health port separate from the local Agent Gateway.
AGENT_RUNTIME_HTTP_ADDR=:8090
TEMPORAL_HOST_PORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=encois-agent-runtime
TEMPORAL_API_KEY=
AGENT_AI_MODE=gemini
AGENT_SOURCE_MODE=gateway
AGENT_MEMORY_MODE=gcp
AGENT_MEMORY_FIXTURE=local
VERTEX_MEMORY_REASONING_ENGINE=
AGENT_GATEWAY_URL=http://127.0.0.1:8080
AGENT_GATEWAY_SERVICE_TOKEN=local-agent-runtime-token
# Optional Cloud Run audience. When set, the client sends a Google ID token
# in Authorization and the service token in X-Encois-Service-Token.
AGENT_GATEWAY_AUDIENCE=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional private Gateway API control-plane boundary for Coordinator Activities.
CONTROL_PLANE_URL=http://127.0.0.1:8787
CONTROL_PLANE_SERVICE_TOKEN=local-control-plane-token
CONTROL_PLANE_AUDIENCE=
# Set true in Cloud Run to use ADC + Vertex AI instead of a Gemini API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_REASONING_THINKING_LEVEL=high
# Set AGENT_SOURCE_MODE=mock only for an explicit deterministic fixture run.
# Gateway mode fails when no real artifact/provider acquisition is configured.
