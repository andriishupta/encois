FROM node:22-bookworm-slim AS build

WORKDIR /workspace
RUN corepack enable
ENV CI=true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile
COPY apps/dashboard apps/dashboard
COPY packages/contracts packages/contracts
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG VITE_PRODUCT_NAME=Encois
ENV VITE_PRODUCT_NAME=${VITE_PRODUCT_NAME}
ARG VITE_WORKSPACE_NAME
ENV VITE_WORKSPACE_NAME=${VITE_WORKSPACE_NAME}
ARG VITE_PRODUCT_LOGO_URL
ENV VITE_PRODUCT_LOGO_URL=${VITE_PRODUCT_LOGO_URL}
ARG VITE_PRODUCT_FAVICON_URL
ENV VITE_PRODUCT_FAVICON_URL=${VITE_PRODUCT_FAVICON_URL}
ARG VITE_SUPPORT_URL
ENV VITE_SUPPORT_URL=${VITE_SUPPORT_URL}
ARG VITE_POWERED_BY_VISIBLE=false
ENV VITE_POWERED_BY_VISIBLE=${VITE_POWERED_BY_VISIBLE}
ARG VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY}
ARG VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN}
ARG VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID}
ARG VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID}
ARG VITE_ENCOIS_SUPPORT_EMAIL
ENV VITE_ENCOIS_SUPPORT_EMAIL=${VITE_ENCOIS_SUPPORT_EMAIL}
ARG VITE_ENCOIS_CREATOR_EMAIL
ENV VITE_ENCOIS_CREATOR_EMAIL=${VITE_ENCOIS_CREATOR_EMAIL}
RUN pnpm --filter @encois/dashboard... build

FROM nginx:1.29-alpine

ARG ENCOIS_VERSION=1.0.0
LABEL org.opencontainers.image.title="Encois Dashboard" \
      org.opencontainers.image.version="${ENCOIS_VERSION}"

COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 8080
