VITE_BASE_PATH=/
VITE_API_BASE_URL=/api/v1

# Identity Platform/Firebase web app configuration. These values identify the
# public web app; never put service-account or OAuth private secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_ENCOIS_SUPPORT_EMAIL=
VITE_ENCOIS_CREATOR_EMAIL=

# Local-only fixture. VITE_* values are embedded into the browser bundle;
# never use a production credential here.
VITE_ENCOIS_ACCESS_TOKEN=
VITE_ENCOIS_ORGANIZATION_ID=
