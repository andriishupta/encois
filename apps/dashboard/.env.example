VITE_BASE_PATH=/
VITE_API_BASE_URL=/api/v1

# Product branding. These are build-time public values; organization data takes
# precedence for the authenticated workspace name.
VITE_PRODUCT_NAME=Encois
VITE_WORKSPACE_NAME=
VITE_PRODUCT_LOGO_URL=
VITE_PRODUCT_FAVICON_URL=
VITE_SUPPORT_URL=
VITE_POWERED_BY_VISIBLE=false

# Identity Platform/Firebase web app configuration. These values identify the
# public web app; never put service-account or OAuth private secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_ENCOIS_SUPPORT_EMAIL=
VITE_ENCOIS_CREATOR_EMAIL=

# Local development authentication. VITE_* values are embedded into the browser bundle;
# never use a production credential here.
VITE_ENCOIS_ACCESS_TOKEN=
VITE_ENCOIS_ORGANIZATION_ID=
VITE_ENCOIS_PERMISSIONS=workflows:read,workflows:run,integrations:read,knowledge:read
