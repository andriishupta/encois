NODE_ENV=development
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=false
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
AGENT_GATEWAY_POLICY_VERSION=policy-read-only-fixture-v1
IDENTITY_PLATFORM_PROJECT_ID=
IDENTITY_PLATFORM_ALLOWED_SIGN_IN_PROVIDERS=google.com
# Local Firebase Auth Emulator only:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Private Runtime -> Gateway control-plane authentication. Keep unset until
# the service user and internal route are configured in the target environment.
CONTROL_PLANE_SERVICE_TOKEN=
CONTROL_PLANE_SERVICE_USER_ID=
# Cloud Run Job/Cloud Scheduler dispatcher input; leave unset for the HTTP API.
COORDINATOR_DISPATCH_ORGANIZATION_ID=
COORDINATOR_DISPATCH_LIMIT=20
# Runtime access only; migrations must use a separate privileged URL.
DATABASE_RUNTIME_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=encois-agent-runtime
TEMPORAL_API_KEY=
TEMPORAL_TLS_CLIENT_CERT_PATH=
TEMPORAL_TLS_CLIENT_KEY_PATH=
