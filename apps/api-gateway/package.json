{
  "name": "@encois/api-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:scripts": "tsc -p tsconfig.scripts.json --noEmit false",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "biome:check": "biome check ./src ./scripts",
    "biome:format": "biome format --write ./src ./scripts",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dispatch:coordinator": "node dist/coordinator-dispatcher.js",
    "dispatch:integration-health": "node dist/integration-health-dispatcher.js",
    "auth:bootstrap-organization": "tsx scripts/bootstrap-organization.ts",
    "auth:onboarding": "tsx scripts/onboarding.ts",
    "auth:invite-user": "tsx scripts/invite-user.ts",
    "auth:list-waitlist": "tsx scripts/list-waitlist.ts",
    "auth:revoke-invite": "tsx scripts/revoke-invite.ts",
    "verify:command-receipts": "tsx scripts/verify-command-receipts.ts"
  },
  "dependencies": {
    "@encois/contracts": "workspace:*",
    "@encois/persistence": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@temporalio/client": "^1.22.0",
    "drizzle-orm": "^0.44.7",
    "firebase-admin": "^13.5.0",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
