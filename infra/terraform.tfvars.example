project_id   = "replace-with-gcp-project-id"
region       = "europe-west1"
environment  = "demo"
domain_name  = "encois.com"

# Hosted Identity Platform uses Google-only sign-in. Supply the OAuth client
# secret through TF_VAR_google_oauth_client_secret or a protected CI secret.
identity_include_localhost  = false
google_oauth_client_id      = ""
google_oauth_client_secret  = ""

# Keep these false until container images and the GCP project are ready.
enable_identity_platform = false
enable_cloud_sql         = false
enable_dashboard         = false
enable_api               = false
enable_agent_runtime     = false
enable_agent_gateway     = false
enable_edge              = false
enable_spanner           = false

# Required when the API or worker is enabled.
temporal_address               = ""
temporal_namespace             = ""
vertex_memory_reasoning_engine = ""
control_plane_service_user_id  = ""

secret_names = [
  "cloud-sql-runtime-url",
  "temporal-client-credentials",
  "agent-gateway-service-token",
  "execution-capability-secret",
  "control-plane-service-token",
]

# Leave empty until the Cloud Storage data plane is enabled. If set, the name
# must be globally unique and the bucket is created by Terraform.
artifact_bucket_name = ""

# Set these only when the corresponding service is enabled.
dashboard_image     = "europe-west1-docker.pkg.dev/replace-with-gcp-project-id/containers/dashboard:replace-with-immutable-tag"
api_image           = "europe-west1-docker.pkg.dev/replace-with-gcp-project-id/containers/api:replace-with-immutable-tag"
agent_runtime_image = "europe-west1-docker.pkg.dev/replace-with-gcp-project-id/containers/agent-runtime:replace-with-immutable-tag"
agent_gateway_image = "europe-west1-docker.pkg.dev/replace-with-gcp-project-id/containers/agent-gateway:replace-with-immutable-tag"
