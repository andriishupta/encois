project_id                  = "replace-with-gcp-project-id"
region                      = "us-east1"
google_cloud_location       = "us-east1"
google_cloud_model_location = "us"
environment                 = "production"
domain_name                 = ""

# Hosted Identity Platform uses Google-only sign-in. Supply the OAuth client
# secret through TF_VAR_google_oauth_client_secret or a protected CI secret.
identity_include_localhost = false
google_oauth_client_id     = ""
google_oauth_client_secret = ""

# Keep these false until container images and the GCP project are ready.
enable_identity_platform = false
enable_cloud_sql         = false
enable_dashboard         = false
enable_api               = false
enable_agent_runtime     = false
enable_agent_gateway     = false
enable_edge              = false
enable_spanner           = false
use_existing_spanner     = false
spanner_instance_id      = ""
# For a manually created Spanner Free Trial instance, use instead:
# use_existing_spanner = true
# spanner_instance_id  = "encois-graph-memory"

# Required when the API or worker is enabled.
temporal_address                       = ""
temporal_namespace                     = "encois"
agent_platform_memory_reasoning_engine = ""
control_plane_service_user_id          = ""
agent_gateway_policy_version           = "replace-with-deployed-read-policy-version"

secret_names = [
  "cloud-sql-runtime-url",
  "cloud-sql-migration-url",
  "cloud-sql-retention-url",
  "temporal-client-credentials",
  "agent-gateway-service-token",
  "agent-runtime-service-token",
  "execution-capability-secret",
  "control-plane-service-token",
  "integration-oauth-config",
  "integration-oauth-state-secret",
]

# Leave empty until the Cloud Storage data plane is enabled. If set, the name
# must be globally unique and the bucket is created by Terraform.
artifact_bucket_name = ""

# Set these only when the corresponding service is enabled.
dashboard_image                     = "us-east1-docker.pkg.dev/replace-with-gcp-project-id/containers/dashboard:replace-with-immutable-tag"
api_image                           = "us-east1-docker.pkg.dev/replace-with-gcp-project-id/containers/api:replace-with-immutable-tag"
agent_runtime_image                 = "us-east1-docker.pkg.dev/replace-with-gcp-project-id/containers/agent-runtime:replace-with-immutable-tag"
agent_gateway_image                 = "us-east1-docker.pkg.dev/replace-with-gcp-project-id/containers/agent-gateway:replace-with-immutable-tag"
migration_image                     = "us-east1-docker.pkg.dev/replace-with-gcp-project-id/containers/migrations:replace-with-immutable-tag"
retention_image                     = "us-east1-docker.pkg.dev/replace-with-gcp-project-id/containers/retention:replace-with-immutable-tag"
retention_organization_ids          = []
integration_health_organization_ids = []

# Leave these empty to use deterministic Cloud Run run.app URLs derived from
# the project number. Set an override only when routing through another edge.
api_service_url           = ""
agent_runtime_service_url = ""
agent_gateway_service_url = ""
