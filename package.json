{
  "name": "encois",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @encois/dashboard dev",
    "dev:api-gateway": "pnpm --filter @encois/api-gateway dev",
    "migration:watch:mock": "node scripts/compose-with-version.mjs compose.watch.mock.yaml run --build --rm migrations",
    "watch:mock:seed": "node scripts/compose-watch-mock-run.mjs local-auth-seed",
    "watch:mock:reset": "node scripts/compose-watch-mock-run.mjs local-auth-seed node dist/scripts/reset-local.js && docker compose -f compose.watch.mock.yaml restart agent-gateway agent-runtime && node scripts/compose-watch-mock-run.mjs local-auth-seed node dist/scripts/seed-local.js",
    "verify:watch:mock": "node scripts/compose-watch-mock-run.mjs local-auth-seed node dist/scripts/verify-local.js",
    "verify:watch:mock:api": "node scripts/compose-watch-mock-run.mjs --env LOCAL_API_URL=http://api-gateway:8787/api/v1 local-auth-seed node dist/scripts/verify-local-api.js",
    "verify:production-auth": "node scripts/verify-production-auth.mjs",
    "dev:watch:mock": "node scripts/compose-with-version.mjs compose.watch.mock.yaml up -d --build",
    "dev:watch:mock:down": "node scripts/compose-with-version.mjs compose.watch.mock.yaml down",
    "dev:watch:prod": "node scripts/compose-with-version.mjs compose.watch.prod.yaml --env-file .env.local.prod up -d --build",
    "dev:watch:prod:down": "node scripts/compose-with-version.mjs compose.watch.prod.yaml --env-file .env.local.prod down",
    "dev:local:prod": "node scripts/compose-with-version.mjs compose.local.prod.yaml --env-file .env.local.prod up -d --build",
    "dev:local:prod:down": "node scripts/compose-with-version.mjs compose.local.prod.yaml --env-file .env.local.prod down",
    "smoke:release": "pnpm --filter @encois/api-gateway exec tsx ../../scripts/smoke-release-flow.ts",
    "smoke:approval": "pnpm --filter @encois/api-gateway exec tsx ../../scripts/smoke-approval-flow.ts",
    "smoke:release:local": "bash scripts/smoke-release-local.sh",
    "e2e": "pnpm --filter @encois/e2e e2e",
    "e2e:open": "pnpm --filter @encois/e2e e2e:open",
    "version:check": "node scripts/check-version.mjs",
    "biome:check": "pnpm --filter @encois/api-gateway biome:check && pnpm --filter @encois/dashboard biome:check && pnpm --filter @encois/persistence biome:check && pnpm --filter @encois/e2e format:check",
    "biome:write": "pnpm --filter @encois/api-gateway biome:write && pnpm --filter @encois/dashboard biome:write && pnpm --filter @encois/persistence biome:write && pnpm --filter @encois/e2e format",
    "biome:format": "pnpm --filter @encois/api-gateway biome:format && pnpm --filter @encois/dashboard biome:format && pnpm --filter @encois/persistence biome:format && pnpm --filter @encois/e2e format",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.10"
  }
}
