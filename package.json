{
  "name": "encois",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @encois/dashboard dev",
    "dev:api-gateway": "pnpm --filter @encois/api-gateway dev",
    "dev:local": "docker compose -f compose.local.yaml up --build",
    "dev:local:down": "docker compose -f compose.local.yaml down",
    "smoke:release": "pnpm --filter @encois/api-gateway exec tsx ../../scripts/smoke-release-flow.ts",
    "smoke:approval": "pnpm --filter @encois/api-gateway exec tsx ../../scripts/smoke-approval-flow.ts",
    "smoke:release:local": "bash scripts/smoke-release-local.sh",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0"
}
