{
  "name": "encois",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @encois/dashboard dev",
    "dev:api-gateway": "pnpm --filter @encois/api-gateway dev",
    "dev:local": "node scripts/compose-with-version.mjs compose.local.yaml up -d --build",
    "local:seed": "docker compose -f compose.local.yaml run --rm local-auth-seed",
    "local:reset": "docker compose -f compose.local.yaml run --rm local-auth-seed node dist/reset-local.js && docker compose -f compose.local.yaml restart agent-gateway agent-runtime && docker compose -f compose.local.yaml run --rm local-auth-seed",
    "verify:local": "docker compose -f compose.local.yaml run --rm local-auth-seed node dist/verify-local.js",
    "verify:local:api": "docker compose -f compose.local.yaml run --rm -e LOCAL_API_URL=http://api-gateway:8787/api/v1 local-auth-seed node dist/verify-local-api.js",
    "dev:local:down": "node scripts/compose-with-version.mjs compose.local.yaml down",
    "dev:local:prod": "node scripts/compose-with-version.mjs compose.local.prod.yaml --env-file .env.local.prod up -d --build",
    "dev:local:prod:down": "node scripts/compose-with-version.mjs compose.local.prod.yaml --env-file .env.local.prod down",
    "smoke:release": "pnpm --filter @encois/api-gateway exec tsx ../../scripts/smoke-release-flow.ts",
    "smoke:approval": "pnpm --filter @encois/api-gateway exec tsx ../../scripts/smoke-approval-flow.ts",
    "smoke:release:local": "bash scripts/smoke-release-local.sh",
    "version:check": "node scripts/check-version.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0"
}
