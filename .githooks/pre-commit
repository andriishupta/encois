#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
readonly ROOT_DIR
cd "$ROOT_DIR"

printf '%s\n' 'Running staged formatting...'
pnpm format:staged
printf '%s\n' 'Reviewing staged projects in parallel...'
pnpm checks:staged

git diff --check
pnpm stage:formatted

printf '%s\n' 'Pre-commit checks passed. Git will preserve the commit message and sign-off.'
