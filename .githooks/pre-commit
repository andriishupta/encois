#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
readonly ROOT_DIR
cd "$ROOT_DIR"

printf '%s\n' 'Running TypeScript formatting and checks...'
pnpm format:staged
pnpm biome:check
pnpm -r lint

printf '%s\n' 'Running Go formatting and checks...'
pnpm go:check -- --staged

git diff --check

printf '%s\n' 'Pre-commit checks passed. Git will preserve the commit message and sign-off.'
