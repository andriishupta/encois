#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
readonly ROOT_DIR
cd "$ROOT_DIR"

printf '%s\n' 'Running TypeScript formatting and checks...'
pnpm format:staged
printf '%s\n' 'Running Biome, TypeScript, and Go checks in parallel...'
pnpm checks:parallel

git diff --check
pnpm stage:formatted

printf '%s\n' 'Pre-commit checks passed. Git will preserve the commit message and sign-off.'
