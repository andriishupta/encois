# Copy to .env.local.ai and keep the copy uncommitted.
# This profile uses local Postgres, Temporal, Firebase Auth/Storage emulators,
# and provider fixtures, but real GCP Spanner and Vertex AI services.

# Absolute path on the host to the ADC JSON created by gcloud auth
# application-default login. Do not use or commit a service-account key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json

GOOGLE_CLOUD_PROJECT=encois
GOOGLE_CLOUD_LOCATION=us-east1

SPANNER_DATABASE=projects/encois/instances/encois-graph-memory/databases/context
VERTEX_MEMORY_REASONING_ENGINE=projects/611842048110/locations/us-east1/reasoningEngines/8217890643486179328

# Optional model overrides.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_REASONING_THINKING_LEVEL=high
