# Copy to .env.local.ai and keep the copy uncommitted.
# This profile uses local Postgres, Temporal, Firebase Auth/Storage emulators,
# and provider fixtures, but real GCP Spanner and Agent Platform services.

# Absolute path on the host to the ADC JSON created by gcloud auth
# application-default login. Do not use or commit a service-account key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json

GOOGLE_CLOUD_PROJECT=encois
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_CLOUD_MODEL_LOCATION=us
TEMPORAL_NAMESPACE=encois

SPANNER_DATABASE=projects/encois/instances/encois-graph-memory/databases/context
AGENT_PLATFORM_MEMORY_REASONING_ENGINE=projects/611842048110/locations/us-east1/reasoningEngines/8217890643486179328

# Optional manual AI seed controls. The manual seed uses the existing local
# sources, uploads deterministic artifacts to the Firebase Storage emulator,
# and starts real Source Ingestion workflows through Temporal.
LOCAL_AI_SEED_SOURCE_LIMIT=5
LOCAL_AI_SEED_REVISION=ai-demo-v1
SEED_ORGANIZATION_SLUG=organization-sun

# Optional model overrides.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REASONING_THINKING_LEVEL=high
