# Copy this file to .env.local.prod and fill it with non-committed local
# development values. It is shared by Watch prod and Local prod; Watch prod
# uses the values with live-reload development containers, while Local prod
# uses production-built containers.

GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
# The containers use your host UID/GID so a normal 0600 ADC file remains
# readable without running the application processes as root.
LOCAL_UID=501
LOCAL_GID=20
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_CLOUD_MODEL_LOCATION=us

# Identity Platform / Firebase browser configuration. These are public client
# settings, but must belong to the same project as the API identity verifier.
IDENTITY_PLATFORM_PROJECT_ID=your-gcp-project
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:8787/api/v1
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=false

# Existing managed control-plane and data-plane resources.
DATABASE_RUNTIME_URL=postgresql://user:password@host:5432/encois
SOURCE_ARTIFACT_BUCKET=your-source-artifact-bucket
GCP_STORAGE_BUCKET=your-agent-gateway-artifact-bucket
SPANNER_DATABASE=projects/your-gcp-project/instances/your-instance/databases/your-database
AGENT_PLATFORM_MEMORY_REASONING_ENGINE=projects/your-gcp-project/locations/us-central1/reasoningEngines/your-engine

# Temporal Cloud.
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.your-account
TEMPORAL_TASK_QUEUE=encois-agent-runtime
TEMPORAL_API_KEY=

# Internal service authentication and signed execution capability. Generate
# independent high-entropy values; do not reuse provider or Firebase secrets.
AGENT_GATEWAY_SERVICE_TOKEN=
CONTROL_PLANE_SERVICE_TOKEN=
CONTROL_PLANE_SERVICE_USER_ID=
AGENT_GATEWAY_CAPABILITY_SECRET=
AGENT_GATEWAY_CAPABILITY_TTL_MS=86400000
AGENT_GATEWAY_POLICY_VERSION=policy-read-only-fixture-v1

# Optional Cloud Run audience values. Leave empty for this local Docker
# network; set them when the managed services require audience validation.
AGENT_GATEWAY_AUDIENCE=
CONTROL_PLANE_AUDIENCE=

IDENTITY_PLATFORM_ALLOWED_SIGN_IN_PROVIDERS=google.com
GEMINI_MODEL=gemini-3.7-flash
