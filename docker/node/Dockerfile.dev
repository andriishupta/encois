FROM node:22-bookworm-slim

ARG ENCOIS_VERSION=1.0.0
LABEL org.opencontainers.image.title="Encois Node Development Runtime" \
      org.opencontainers.image.version="${ENCOIS_VERSION}"

WORKDIR /workspace
RUN corepack enable

# Dependencies live in the image; Compose mounts the source tree at runtime.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
ENV ENCOIS_VERSION=${ENCOIS_VERSION}
COPY apps/api-gateway/package.json apps/api-gateway/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/persistence/package.json packages/persistence/package.json
RUN pnpm install --frozen-lockfile

EXPOSE 5173 8787
